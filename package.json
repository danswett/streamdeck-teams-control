{
	"name": "streamdeck-teams-control",
	"version": "1.0.0",
	"private": true,
	"description": "Stream Deck plugin that controls Microsoft Teams meetings through UI Automation.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "npm run build:sidecar && npm run build:plugin",
		"build:plugin": "rollup -c",
		"build:sidecar": "dotnet publish sidecar/TeamsBridge.csproj -c Release -o com.dswett.teamscontrol.sdPlugin/bin/sidecar --nologo",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.dswett.teamscontrol\"",
		"validate": "streamdeck validate com.dswett.teamscontrol.sdPlugin",
		"pack": "npm run build && streamdeck pack com.dswett.teamscontrol.sdPlugin --output dist --no-update-check"
	},
	"devDependencies": {
		"@elgato/cli": "^1.9.0",
		"@resvg/resvg-js": "^2.6.2",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~24.1.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.2",
		"@elgato/utils": "^0.6.0"
	}
}
