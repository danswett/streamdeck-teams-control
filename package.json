{
	"name": "streamdeck-teams-control",
	"version": "1.0.0",
	"private": true,
	"description": "Stream Deck plugin that controls Microsoft Teams meetings through UI Automation.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "npm run build:sidecar && npm run build:plugin",
		"build:plugin": "rollup -c",
		"build:sidecar": "dotnet publish sidecar/TeamsBridge.csproj -c Release -o com.bad-duck.teamscontrol.sdPlugin/bin/sidecar --nologo",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.bad-duck.teamscontrol\"",
		"validate": "streamdeck validate com.bad-duck.teamscontrol.sdPlugin",
		"test": "npm run audit && npm run test:ts && npm run test:cs",
		"test:ts": "vitest run",
		"test:cs": "dotnet test sidecar/tests/TeamsBridge.Tests.csproj --nologo",
		"audit": "node tools/audit-docs.js",
		"marketplace": "node tools/generate-marketplace.ts",
		"demo": "node tools/build-demo-frames.ts",
		"pack": "npm run build && streamdeck pack com.bad-duck.teamscontrol.sdPlugin --output dist --no-update-check"
	},
	"devDependencies": {
		"@elgato/cli": "^1.9.0",
		"@fluentui/svg-icons": "^1.1.341",
		"@resvg/resvg-js": "^2.6.2",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/adm-zip": "^0.5.8",
		"@types/node": "~24.1.0",
		"adm-zip": "^0.6.0",
		"fluentui-emoji": "^1.3.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.2",
		"@elgato/utils": "^0.6.0"
	}
}
