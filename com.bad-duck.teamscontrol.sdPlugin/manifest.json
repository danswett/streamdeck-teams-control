{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Teams Meeting Controls",
	"Version": "1.8.3.0",
	"Author": "Bad Duck Software",
	"Description": "Control Microsoft Teams meetings and PowerPoint Live from your Stream Deck: mute, camera, raise hand, reactions, blur, slide navigation and drawing tools. Every key shows the real state. Teams never needs focus, and no keystrokes are sent.",
	"Category": "Teams Meeting Controls",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://bad-duck.com",
	"SupportURL": "https://github.com/danswett/streamdeck-teams-control/issues",
	"CodePath": "bin/plugin.js",
	"PropertyInspectorPath": "ui/default.html",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.bad-duck.teamscontrol",
	"ApplicationsToMonitor": {
		"windows": [
			"ms-teams.exe"
		]
	},
	"Profiles": [
		{
			"Name": "profiles/Teams Meeting",
			"DeviceType": 0,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true
		},
		{
			"Name": "profiles/PowerPoint Live (Attendee)",
			"DeviceType": 0,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true
		},
		{
			"Name": "profiles/PowerPoint Live (Presenter)",
			"DeviceType": 0,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true
		},
		{
			"Name": "profiles/Teams Meeting (+ XL)",
			"DeviceType": 13,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true
		},
		{
			"Name": "profiles/PowerPoint Live (Attendee) (+ XL)",
			"DeviceType": 13,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true
		},
		{
			"Name": "profiles/PowerPoint Live (Presenter) (+ XL)",
			"DeviceType": 13,
			"Readonly": false,
			"DontAutoSwitchWhenInstalled": true
		}
	],
