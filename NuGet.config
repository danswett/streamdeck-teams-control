<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scoped to this repo so it builds without the machine's internal feeds,
    which require interactive auth. Only the public gallery is needed: the
    sidecar's one dependency, FlaUI.UIA3, is published there.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
