<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TeamsBridge</AssemblyName>
    <RootNamespace>TeamsBridge</RootNamespace>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!--
      Trimming turns built-in COM interop off by default, which breaks UIA
      (FlaUI throws "Built-in COM has been disabled via a feature switch").
    -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!--
      This is a background process that spends nearly all its time asleep, so
      it is tuned for a small footprint rather than throughput. Concurrent GC
      buys latency the sidecar does not need, at the cost of a dedicated thread
      and extra committed memory.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!--
      UseSystemResourceKeys is deliberately left off. It would trim framework
      exception strings down to resource keys, but this plugin is diagnosed
      from the messages it reports when Teams' tree changes, and the saving
      measured 367 KB - about 1.5% of the published size.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      The test project lives under this one's directory, so the SDK's default
      globbing would otherwise compile its files - and its xunit references -
      into the sidecar itself.
    -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />

    <!-- So the test project can reach LoadConfig and ParseConfig. -->
    <InternalsVisibleTo Include="TeamsBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FlaUI wraps the UI Automation COM API (UIA3) without dragging in the WPF
      desktop runtime, which keeps the published sidecar small and trimmable.
    -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
